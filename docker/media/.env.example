# docker/media/.env.example
# Copy to .env and adjust. Never commit .env.

TZ=Europe/Prague

# linuxserver.io runs its containers as a fixed user/group.
PUID=1000
PGID=1000

# Media library locations on the NAS (see ansible/group_vars/nas.yml).
MEDIA_ROOT=/srv/media
MOVIES_DIR=${MEDIA_ROOT}/movies
TV_DIR=${MEDIA_ROOT}/tv
MUSIC_DIR=${MEDIA_ROOT}/music